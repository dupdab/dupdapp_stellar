# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dupdapp

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# App
NODE_ENV=development
PORT=3000

# Soroban contract event indexer
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_EVENT_CONTRACT_IDS=
SOROBAN_EVENT_START_LEDGER=1
SOROBAN_EVENT_POLL_INTERVAL_MS=5000
